#!/usr/bin/env bash
set -euo pipefail

THEMES="$HOME/.local/share/niveth/brave/themes"
CURRENT="$THEMES/current"

if [[ ! -d "$THEMES/light" || ! -f "$THEMES/light/manifest.json" ]]; then
    echo "ERROR: Niveth Brave Light theme missing: $THEMES/light" >&2
    exit 1
fi

if [[ ! -d "$THEMES/dark" || ! -f "$THEMES/dark/manifest.json" ]]; then
    echo "ERROR: Niveth Brave Dark theme missing: $THEMES/dark" >&2
    exit 1
fi

SCHEME="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || true)"

case "$SCHEME" in
    "'prefer-dark'")
        MODE="dark"
        ;;
    *)
        MODE="light"
        ;;
esac

ln -sfn "$MODE" "$CURRENT"

echo "Niveth Brave theme: $MODE"

LAUNCHER=""

if [[ -x "$HOME/.local/bin/niveth-brave" ]]; then
    LAUNCHER="$HOME/.local/bin/niveth-brave"
elif [[ -x "/usr/local/bin/niveth-brave" ]]; then
    LAUNCHER="/usr/local/bin/niveth-brave"
else
    echo "ERROR: Niveth Brave launcher not found" >&2
    exit 1
fi

# Brave is not running: next launch will use the correct theme.
if ! pgrep -x brave-browser >/dev/null 2>&1 && \
   ! pgrep -x brave >/dev/null 2>&1; then
    echo "Brave is not running; theme will apply on next launch."
    exit 0
fi

echo "Restarting Brave..."

pkill -TERM -x brave-browser 2>/dev/null || true
pkill -TERM -x brave 2>/dev/null || true

for _ in {1..30}; do
    if ! pgrep -x brave-browser >/dev/null 2>&1 && \
       ! pgrep -x brave >/dev/null 2>&1; then
        break
    fi
    sleep 0.2
done

pkill -KILL -x brave-browser 2>/dev/null || true
pkill -KILL -x brave 2>/dev/null || true

sleep 1

nohup "$LAUNCHER" >/dev/null 2>&1 &

echo "Brave restarted with Niveth $MODE theme."
